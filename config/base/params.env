trustyaiServiceImage=quay.io/ruimvieira/trustyai-service:latest
trustyaiOperatorImage=quay.io/ruimvieira/trustyai-service-operator-ragas:latest
oauthProxyImage=quay.io/openshift/origin-oauth-proxy:4.14.0
kServeServerless=enabled
lmes-driver-image=quay.io/ruimvieira/ta-lmes-driver:latest
lmes-pod-image=quay.io/ruimvieira/ta-lmes-pod:latest
lmes-pod-checking-interval=10s
lmes-image-pull-policy=Always
lmes-max-batch-size=24
lmes-default-batch-size=8
lmes-detect-device=true
lmes-allow-online=true
lmes-allow-code-execution=true
guardrails-orchestrator-image=quay.io/ruimvieira/ta-guardrails-orchestrator:latest
guardrails-built-in-detector-image=quay.io/ruimvieira/regex-detector:latest
guardrails-sidecar-gateway-image=quay.io/ruimvieira/guardrails-sidecar-gateway:latest
