trustyaiServiceImage=quay.io/ruimvieira/trustyai-service-bump-0.4.8:latest
trustyaiOperatorImage=quay.io/ruimvieira/trustyai-service-operator-bump-0.4.8:latest
oauthProxyImage=quay.io/openshift/origin-oauth-proxy:4.14.0
lmes-driver-image=quay.io/ruimvieira/ta-lmes-driver-bump-0.4.8:latest
lmes-pod-image=quay.io/ruimvieira/ta-lmes-pod-bump-0.4.8:latest
guardrails-orchestrator-image=quay.io/ruimvieira/guardrails-orchestrator-bump-0.4.8:latest
guardrails-built-in-detector-image=quay.io/ruimvieira/guardrails-built-in-detector-bump-0.4.8:latest
guardrails-sidecar-gateway-image=quay.io/ruimvieira/guardrails-sidecar-gateway-bump-0.4.8:latest
kServeServerless=enabled
lmes-allow-code-execution=true
lmes-allow-online=true
lmes-default-batch-size=8
lmes-detect-device=true
lmes-max-batch-size=24
lmes-pod-checking-interval=10s
